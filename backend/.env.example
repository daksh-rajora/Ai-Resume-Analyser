# Environment
NODE_ENV=production
PORT=5000

# Database & Authentication
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=arr_token

# CORS - Frontend Origin(s) (comma-separated if multiple, e.g. local + Vercel domain)
CLIENT_ORIGIN=https://ai-resume-psi-flame.vercel.app,http://localhost:5173

# AI Analysis (OpenRouter API)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
